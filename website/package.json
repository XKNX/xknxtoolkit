{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx && uv tool install ./node_modules/fumadocs-python --reinstall",
    "lint": "oxlint",
    "generate:docs": "node scripts/generate-docs.mjs",
    "generate:openapi": "cd ../packages/catalog && uv run export-openapi openapi.json"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "fumadocs-core": "16.9.0",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-openapi": "^10.9.0",
    "fumadocs-python": "^0.0.11",
    "fumadocs-ui": "16.9.0",
    "glob": "^13.0.6",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.65.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
